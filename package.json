    "check-balance": "tsx scripts/check-balance.ts",
    "frontend:dev": "npm run dev --prefix frontend"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
